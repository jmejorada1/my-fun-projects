# Copy to .env and adjust if you want a different Postgres password.
# Optional — docker-compose.yml falls back to the same password already
# hardcoded in backend/posts/src/main/resources/application.yml, so the
# stack runs with zero setup if you skip this file.
POSTGRES_PASSWORD=P@55w0rd

# Host ports this stack publishes. All optional — docker-compose.yml falls
# back to these same defaults if you skip this file. This is the one place
# to change a port: docker-compose.yml's port mappings, posts' CORS origin
# (APP_CORS_ALLOWED_ORIGINS), the frontend's own API_BASE_URL (generated
# into /config.json at container startup — see docker-entrypoint.sh and
# src/app/core/api-config.ts), and scripts/docker-{precheck,run,reload}.sh's
# port-freeness checks and printed URLs all derive from these three
# variables, so they can't drift out of sync with each other — including
# the frontend, which no longer needs a rebuild to point at a different
# API_PORT, just a container restart.
FRONTEND_PORT=4200
API_PORT=8080
POSTGRES_PORT=5433
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana's admin password (username: admin). The "admin" default is fine
# for local/dev use only — same pattern as POSTGRES_PASSWORD above. Set
# this before running anywhere reachable outside your own machine.
# posts' own metrics port (application.yml's management.server.port) is
# never published to the host at all, so it has no equivalent variable
# here — see root README's "Metrics & Monitoring".
GRAFANA_ADMIN_PASSWORD=admin
